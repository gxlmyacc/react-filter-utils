{
  "name": "react-filter-utils",
  "version": "0.1.4",
  "description": "filter utils for react",
  "keywords": [
    "react",
    "filter"
  ],
  "sideEffects": [
    "cjs/**/*.js"
  ],
  "main": "cjs/index.js",
  "module": "es/index.js",
  "typings": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./es/index.js",
      "require": "./cjs/index.js",
      "default": "./cjs/index.js"
    },
    "./es": {
      "types": "./types/index.d.ts",
      "import": "./es/index.js",
      "require": "./cjs/index.js",
      "default": "./es/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "files": [
    "cjs",
    "es",
    "src",
    "types"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:examples": "tsc --noEmit -p examples/tsconfig.json",
    "lint": "eslint src tests",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build",
    "build": "npm run build:types && npm run build:cjs && npm run build:es",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:cjs": "cross-env BUILD_ENV=cjs babel src -d cjs --extensions \".ts,.tsx\" --source-maps",
    "build:es": "cross-env BUILD_ENV=es babel src -d es --extensions \".ts,.tsx\"",
    "prepublishOnly": "npm run ci"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gxlmyacc/react-filter-utils.git"
  },
  "author": "gxlmyacc",
  "dependencies": {
    "core-js": "^3"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.0",
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/plugin-transform-modules-commonjs": "^7.25.9",
    "@babel/plugin-transform-object-rest-spread": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@eslint/js": "^9.39.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.0",
    "babel-jest": "^30.4.1",
    "cross-env": "^5.2.0",
    "eslint": "^9.39.1",
    "jest": "^30.4.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.4"
  }
}
